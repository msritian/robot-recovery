# Builds the dependency image on a CHTC build node and writes it to /staging.
# Bump IMAGE (and container_image in sweep.sub) on every rebuild: OSDF caches by file name.
IMAGE = robot_recovery_v1.sif
universe = vanilla
+IsBuildJob = true
requirements = (OpSysMajorVer =?= 9) && (HasCHTCStaging == true)

executable = build_container.sh
arguments = $(IMAGE)
transfer_output_files = $(IMAGE), pip-freeze.txt
transfer_output_remaps = "$(IMAGE) = file:///staging/s/smittal39/robot-recovery/$(IMAGE); pip-freeze.txt = build-pip-freeze.txt"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

log = build.log
output = build.out
error = build.err

request_cpus = 4
request_memory = 8GB
request_disk = 20GB
queue
