# Builds robot_recovery.sif on a CHTC build node and returns it to the submit directory.
universe = vanilla
executable = /usr/bin/apptainer
transfer_executable = false
arguments = build robot_recovery.sif robot_recovery.def
transfer_input_files = robot_recovery.def
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = robot_recovery.sif

+IsBuildJob = true
request_cpus = 4
request_memory = 8GB
request_disk = 16GB

log = build.log
output = build.out
error = build.err
queue
