Bootstrap: docker
From: python:3.10-slim

# Dependencies only; the repo code is shipped with each job so the reward/env can change without a rebuild.
# Versions match pyproject.toml. CPU-only torch keeps the image small.

%post
    apt-get update && apt-get install -y --no-install-recommends libosmesa6 libgl1 libglfw3 && rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir torch==2.4.1 --index-url https://download.pytorch.org/whl/cpu
    pip install --no-cache-dir \
        gymnasium==0.29.1 mujoco==2.3.3 numpy==1.24.4 "tensorboard>=2.10,<2.16" tyro==0.5.10 \
        moviepy==1.0.3 "imageio>=2.14.1,<3" pyopengl "pandas>=2.0,<2.3" "matplotlib>=3.7,<3.10" "scipy>=1.10,<1.14"

%environment
    export MUJOCO_GL=osmesa
    export PYOPENGL_PLATFORM=osmesa
    export OMP_NUM_THREADS=1
    export MKL_NUM_THREADS=1
